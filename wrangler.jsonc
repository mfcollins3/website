{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "michaelfcollins3-dev",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "michaelfcollins3-dev",
			"migrations_dir": "../../migrations",
			"database_id": "5ce1636a-27c7-44fd-97b3-fbe3b43b13f0",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "michaelfcollins3-dev-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "283db271d81143c597630bb08d23cd18",
		},
	],
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "michaelfcollins3-dev-preview"
				}
			]
		}
	}
}